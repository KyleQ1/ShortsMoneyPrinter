# Settings for ShortsMoneyPrinter. Copy to .env and fill in. .env is gitignored.
# Loaded automatically by app/config.py (does not override real env vars).
# Everything here is optional — the app runs on defaults with no .env at all.

# Cloud video generation (BYO key) — only needed for the remote Seedance models:
REPLICATE_API_TOKEN=
# Alternative cloud provider:
# FAL_KEY=

# Optional AI prompt writer. If enabled in the Web UI, these can be used instead of
# pasting a key into the form. OpenAI-compatible chat/completions endpoints work.
# PROMPT_API_KEY=
# PROMPT_MODEL=gpt-4o-mini
# PROMPT_API_BASE=https://api.openai.com/v1

# Optional yt-dlp helper for YouTube videos that need logged-in cookies.
# Use a Netscape-format cookies.txt export; never commit the file.
# YTDLP_COOKIES_FILE=/absolute/path/to/youtube-cookies.txt

# Optional runtime knobs (sensible defaults if unset):
# VIDEO_ENDPOINT=replicate     # replicate | fal
# TTS_VOICE=en-US-AriaNeural   # voice when a run's audio mode is "tts"
# WHISPER_MODEL=large-v3       # caption model: tiny | base | small | medium | large-v3
